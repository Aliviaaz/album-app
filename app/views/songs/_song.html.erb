<li id="<%= dom_id song %>">
  <%= link_to song, class: "flex items-center gap-4 px-4 py-3 transition-colors hover:bg-slate-50 sm:px-6" do %>
    <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500" aria-hidden="true">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5"><path d="M17.721 1.599a.75.75 0 0 1 .279.583v11.29a2.25 2.25 0 0 1-1.774 2.2l-2.041.44a2.216 2.216 0 0 1-.938-4.332l2.662-.577a.75.75 0 0 0 .591-.733V6.112l-8 1.73v7.684a2.25 2.25 0 0 1-1.774 2.2l-2.042.44a2.216 2.216 0 1 1-.935-4.331l2.659-.573A.75.75 0 0 0 7 12.529V4.236a.75.75 0 0 1 .591-.733l9.5-2.054a.75.75 0 0 1 .63.15Z"/></svg>
    </span>
    <span class="min-w-0 flex-1">
      <span class="block truncate font-semibold text-slate-900"><%= song.name %></span>
      <span class="block truncate text-sm text-slate-500"><%= song.album&.title %></span>
    </span>
    <% if song.is_favorite %>
      <span class="inline-flex items-center gap-1 rounded-full bg-rose-50 px-2.5 py-0.5 text-xs font-medium text-rose-700 ring-1 ring-inset ring-rose-600/20">
        <span aria-hidden="true">&hearts;</span> Favorite
      </span>
    <% end %>
  <% end %>
</li>
