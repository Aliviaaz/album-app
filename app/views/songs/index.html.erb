<% content_for :title, "Songs" %>

<% content_for :page_actions do %>
  <%= link_to "New song", new_song_path, class: button_classes(:primary) %>
<% end %>

<%= render "shared/page_header", title: "Songs", subtitle: "Every track across your albums" %>

<% if @songs.any? %>
  <ul id="songs" role="list" class="divide-y divide-slate-100 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
    <%= render @songs %>
  </ul>
<% else %>
  <div id="songs">
    <%= render "shared/empty_state",
          title: "No songs yet",
          message: "Add a song to one of your albums.",
          action_label: "New song",
          action_path: new_song_path %>
  </div>
<% end %>
