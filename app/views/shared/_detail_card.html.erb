<%# locals: (record:, delete_label:) -%>
<%# Wraps a show-page body with the Edit / Delete actions in a consistent card. %>
<div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
  <div class="p-6 sm:p-8">
    <%= yield %>
  </div>
  <div class="flex flex-wrap items-center justify-end gap-2 border-t border-slate-200 bg-slate-50 px-6 py-4 sm:px-8">
    <%= link_to "Edit", [ :edit, record ], class: button_classes(:secondary) %>
    <%= button_to delete_label, record, method: :delete,
          class: button_classes(:danger),
          form: { data: { turbo_confirm: "Are you sure? This can't be undone." } } %>
  </div>
</div>
