<%# locals: (record:) -%>
<% if record.errors.any? %>
  <div role="alert" class="rounded-lg border border-red-200 bg-red-50 p-4">
    <h2 class="text-sm font-semibold text-red-800">
      <%= pluralize(record.errors.count, "error") %> prohibited this <%= record.model_name.human.downcase %> from being saved:
    </h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
      <% record.errors.each do |error| %>
        <li><%= error.full_message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
