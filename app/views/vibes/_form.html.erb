<%= form_with(model: vibe, class: "max-w-xl space-y-6 rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 sm:p-8") do |form| %>
  <%= render "shared/form_errors", record: vibe %>

  <div class="space-y-2">
    <%= form.label :name, class: label_classes %>
    <%= form.text_field :name, class: input_classes, placeholder: "e.g. Late night", autofocus: true %>
  </div>

  <div class="flex items-center justify-end gap-3 border-t border-slate-200 pt-6">
    <%= link_to "Cancel", (vibe.persisted? ? vibe : vibes_path), class: button_classes(:secondary) %>
    <%= form.submit class: button_classes(:primary) %>
  </div>
<% end %>
