<% content_for :title, "Vibes" %>

<% content_for :page_actions do %>
  <%= link_to "New vibe", new_vibe_path, class: button_classes(:primary) %>
<% end %>

<%= render "shared/page_header", title: "Vibes", subtitle: "Moods and feelings to tag your music with" %>

<% if @vibes.any? %>
  <div id="vibes" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
    <%= render @vibes %>
  </div>
<% else %>
  <div id="vibes">
    <%= render "shared/empty_state",
          title: "No vibes yet",
          message: "Create a vibe like “chill” or “late night” to tag songs.",
          action_label: "New vibe",
          action_path: new_vibe_path %>
  </div>
<% end %>
